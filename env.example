# Copy this file to .env for local runs. On a host, set these as environment variables instead.
DISCORD_TOKEN=paste-your-bot-token-here

# Optional: your server's ID so slash commands appear instantly (handy while testing)
GUILD_ID=

# Optional: currency name used when /create_auction doesn't set one (for example gold or $)
DEFAULT_CURRENCY=

# Optional: set to 1 to save running auctions and resume them after a restart.
# Off by default: every start is clean and nothing from earlier runs is tracked.
KEEP_AUCTIONS=

# Only used when KEEP_AUCTIONS=1. Point it at a persistent volume when hosting.
AUCTION_DATA_FILE=data/auctions.json
